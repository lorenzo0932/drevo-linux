/* Adwaita-inspired, neutro tra desktop. */
QMainWindow, QWidget#page { background: #fafafa; color: #2e3436; }
QListWidget#nav { background: #ebebeb; border: none; font-size: 15px; }
QListWidget#nav::item { padding: 10px 14px; border-radius: 8px; }
QListWidget#nav::item:selected { background: #dce7f5; color: #1a5fb4; }
QLabel#title { font-size: 22px; font-weight: 800; }
QLabel#hint { color: #5e5c64; }
QPushButton { background: white; border: 1px solid #c9c9c9;
    border-radius: 8px; padding: 8px 16px; }
QPushButton:hover { background: #f0f0f0; }
QPushButton#accent { background: #3584e4; color: white; border: none;
    font-weight: 700; }
QPushButton#accent:hover { background: #1c71d8; }
QPushButton#swatch { border-radius: 8px; padding: 6px 12px; }
QComboBox, QSpinBox { background: white; border: 1px solid #c9c9c9;
    border-radius: 8px; padding: 6px 10px; }
QSlider::groove:horizontal { height: 4px; background: #d5d5d5;
    border-radius: 2px; }
QSlider::handle:horizontal { width: 18px; height: 18px; background: white;
    border: 1px solid #c9c9c9; border-radius: 9px; margin: -7px 0; }
QGroupBox { border: 1px solid #d5d5d5; border-radius: 12px;
    margin-top: 12px; background: white; }
QGroupBox::title { subcontrol-origin: margin; left: 12px; color: #5e5c64; }
