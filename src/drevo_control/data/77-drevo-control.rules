# Tastiere Drevo Winbond 0416:a0f8 — accesso userspace all'HID di controllo.
# Installata da Drevo Control (Impostazioni) in /etc/udev/rules.d/
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0416", ATTRS{idProduct}=="a0f8", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="0416", ATTRS{idProduct}=="a0f8", TAG+="uaccess"
